# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local. The SERVICE ROLE key and Stripe SECRET key are
# server-only secrets and must never be exposed to the browser.
# ---------------------------------------------------------------------------

# --- Public site URL (used for Stripe success/cancel redirects) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL + publishable key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key: SERVER ONLY. Bypasses RLS. Used by API routes + seed script.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Storage bucket that holds uploaded logos (create it as a public bucket).
SUPABASE_LOGO_BUCKET=logos

# --- Payment provider -------------------------------------------------------
# Which provider drives checkout: "stripe" or "dodo". Defaults to stripe.
PAYMENT_PROVIDER=stripe

# --- Stripe (used when PAYMENT_PROVIDER=stripe) ------------------------------
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# From `stripe listen` locally, or the dashboard webhook endpoint in prod.
# Stripe webhook endpoint: /api/webhook/stripe
STRIPE_WEBHOOK_SECRET=whsec_xxx

# --- Dodo Payments (used when PAYMENT_PROVIDER=dodo) -------------------------
DODO_PAYMENTS_API_KEY=
DODO_ENVIRONMENT=test_mode          # test_mode | live_mode
# Create ONE product in Dodo with "Pay What You Want" pricing ENABLED; the
# per-checkout amount overrides its price. Put that product's id here.
DODO_PRODUCT_ID=
# Signing secret for the Dodo webhook (Standard Webhooks scheme).
# Dodo webhook endpoint: /api/webhook/dodo
DODO_WEBHOOK_KEY=
# ISO 3166-1 alpha-2 country used as the billing default on the payment link.
DODO_DEFAULT_COUNTRY=US

# --- Image moderation (optional but STRONGLY recommended) -------------------
# If OPENAI_API_KEY is set, uploaded logos are screened before they can be
# used. If left blank, moderation is a PASS-THROUGH (dev only — never ship
# a public board without a moderation provider wired in).
OPENAI_API_KEY=

# --- Cloudflare Turnstile (optional bot wall) -------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
